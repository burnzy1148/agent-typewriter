{
  "name": "agent-typewriter",
  "displayName": "Agent Typewriter",
  "description": "Watches files change on disk (from Claude Code or any agent) and replays each change as if a person were typing it, flipping between files in the order they changed.",
  "version": "0.1.0",
  "publisher": "burnzy1148",
  "license": "MIT",
  "author": {
    "name": "Eric Burns"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/burnzy1148/agent-typewriter.git"
  },
  "homepage": "https://github.com/burnzy1148/agent-typewriter#readme",
  "bugs": {
    "url": "https://github.com/burnzy1148/agent-typewriter/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "ai",
    "agent",
    "typing",
    "typewriter",
    "replay",
    "playback",
    "demo",
    "screencast"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "agentTypewriter.start",
        "title": "Start Watching",
        "category": "Agent Typewriter",
        "icon": "$(eye)"
      },
      {
        "command": "agentTypewriter.stop",
        "title": "Stop Watching",
        "category": "Agent Typewriter",
        "icon": "$(eye-closed)"
      },
      {
        "command": "agentTypewriter.togglePause",
        "title": "Pause / Resume Playback",
        "category": "Agent Typewriter",
        "icon": "$(debug-pause)"
      },
      {
        "command": "agentTypewriter.finishCurrent",
        "title": "Finish Current Change Instantly",
        "category": "Agent Typewriter",
        "icon": "$(debug-step-over)"
      },
      {
        "command": "agentTypewriter.catchUp",
        "title": "Skip to Latest",
        "category": "Agent Typewriter",
        "icon": "$(debug-continue)"
      },
      {
        "command": "agentTypewriter.replayAll",
        "title": "Replay Entire Buffer",
        "category": "Agent Typewriter",
        "icon": "$(history)"
      },
      {
        "command": "agentTypewriter.replayFrom",
        "title": "Replay From Here",
        "category": "Agent Typewriter",
        "icon": "$(play)"
      },
      {
        "command": "agentTypewriter.showDiff",
        "title": "Show Diff",
        "category": "Agent Typewriter",
        "icon": "$(diff)"
      },
      {
        "command": "agentTypewriter.clear",
        "title": "Clear Buffer",
        "category": "Agent Typewriter",
        "icon": "$(clear-all)"
      },
      {
        "command": "agentTypewriter.saveSession",
        "title": "Save Session to File...",
        "category": "Agent Typewriter",
        "icon": "$(save)"
      },
      {
        "command": "agentTypewriter.loadSession",
        "title": "Load Session from File...",
        "category": "Agent Typewriter",
        "icon": "$(folder-opened)"
      },
      {
        "command": "agentTypewriter.setExtensions",
        "title": "Set Watched Extensions...",
        "category": "Agent Typewriter",
        "icon": "$(filter)"
      },
      {
        "command": "agentTypewriter.watchOnlyThis",
        "title": "Agent Typewriter: Watch Only This",
        "category": "Agent Typewriter"
      },
      {
        "command": "agentTypewriter.addToWatch",
        "title": "Agent Typewriter: Add to Watch Filter",
        "category": "Agent Typewriter"
      },
      {
        "command": "agentTypewriter.resetFilters",
        "title": "Reset Filters",
        "category": "Agent Typewriter"
      },
      {
        "command": "agentTypewriter.openRepoSettings",
        "title": "Open Repository Settings File",
        "category": "Agent Typewriter"
      },
      {
        "command": "agentTypewriter.setSpeed",
        "title": "Set Playback Speed...",
        "category": "Agent Typewriter",
        "icon": "$(dashboard)"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "agentTypewriter.timeline",
          "name": "Agent Typewriter"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "agentTypewriter.timeline",
        "when": "!agentTypewriter.watching",
        "contents": "Not watching yet. Start watching and every matching file change will be recorded here and replayed as typing.\n[Start Watching](command:agentTypewriter.start)\n[Set Watched Extensions](command:agentTypewriter.setExtensions)"
      },
      {
        "view": "agentTypewriter.timeline",
        "when": "agentTypewriter.watching",
        "contents": "Watching. Let your agent edit some files and each change will show up here, in order, as it is typed out in the replay editor."
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agentTypewriter.start",
          "when": "view == agentTypewriter.timeline && !agentTypewriter.watching",
          "group": "navigation@1"
        },
        {
          "command": "agentTypewriter.stop",
          "when": "view == agentTypewriter.timeline && agentTypewriter.watching",
          "group": "navigation@1"
        },
        {
          "command": "agentTypewriter.togglePause",
          "when": "view == agentTypewriter.timeline",
          "group": "navigation@2"
        },
        {
          "command": "agentTypewriter.finishCurrent",
          "when": "view == agentTypewriter.timeline",
          "group": "navigation@3"
        },
        {
          "command": "agentTypewriter.catchUp",
          "when": "view == agentTypewriter.timeline",
          "group": "navigation@4"
        },
        {
          "command": "agentTypewriter.replayAll",
          "when": "view == agentTypewriter.timeline",
          "group": "navigation@5"
        },
        {
          "command": "agentTypewriter.setExtensions",
          "when": "view == agentTypewriter.timeline",
          "group": "1_config@1"
        },
        {
          "command": "agentTypewriter.setSpeed",
          "when": "view == agentTypewriter.timeline",
          "group": "1_config@2"
        },
        {
          "command": "agentTypewriter.resetFilters",
          "when": "view == agentTypewriter.timeline",
          "group": "1_config@3"
        },
        {
          "command": "agentTypewriter.openRepoSettings",
          "when": "view == agentTypewriter.timeline",
          "group": "1_config@4"
        },
        {
          "command": "agentTypewriter.clear",
          "when": "view == agentTypewriter.timeline",
          "group": "2_buffer@1"
        },
        {
          "command": "agentTypewriter.saveSession",
          "when": "view == agentTypewriter.timeline",
          "group": "2_buffer@2"
        },
        {
          "command": "agentTypewriter.loadSession",
          "when": "view == agentTypewriter.timeline",
          "group": "2_buffer@3"
        }
      ],
      "view/item/context": [
        {
          "command": "agentTypewriter.replayFrom",
          "when": "view == agentTypewriter.timeline && viewItem == changeEvent",
          "group": "inline@1"
        },
        {
          "command": "agentTypewriter.showDiff",
          "when": "view == agentTypewriter.timeline && viewItem == changeEvent",
          "group": "inline@2"
        }
      ],
      "explorer/context": [
        {
          "command": "agentTypewriter.watchOnlyThis",
          "group": "z_agentTypewriter@1"
        },
        {
          "command": "agentTypewriter.addToWatch",
          "group": "z_agentTypewriter@2"
        }
      ],
      "commandPalette": [
        {
          "command": "agentTypewriter.replayFrom",
          "when": "false"
        },
        {
          "command": "agentTypewriter.showDiff",
          "when": "false"
        },
        {
          "command": "agentTypewriter.watchOnlyThis",
          "when": "false"
        },
        {
          "command": "agentTypewriter.addToWatch",
          "when": "false"
        }
      ]
    },
    "jsonValidation": [
      {
        "fileMatch": ".agent-typewriter.json",
        "url": "./schemas/agent-typewriter.schema.json"
      }
    ],
    "configuration": {
      "title": "Agent Typewriter",
      "properties": {
        "agentTypewriter.autoStart": {
          "type": "boolean",
          "default": false,
          "description": "Start watching automatically when a workspace opens."
        },
        "agentTypewriter.include": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/*"
          ],
          "description": "Workspace-relative globs to watch. A pattern without a slash (like *.ts) matches the file name anywhere."
        },
        "agentTypewriter.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/.git/**",
            "**/node_modules/**",
            "**/dist/**",
            "**/out/**",
            "**/build/**",
            "**/target/**",
            "**/.gradle/**",
            "**/.idea/**",
            "**/*.lock",
            "**/package-lock.json",
            "**/*.log"
          ],
          "description": "Workspace-relative globs to ignore. Exclude wins over include."
        },
        "agentTypewriter.extensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Only watch these file extensions (for example [\"ts\", \"java\", \"md\"]). Empty means any extension that passes include/exclude."
        },
        "agentTypewriter.charsPerSecond": {
          "type": "number",
          "default": 35,
          "minimum": 1,
          "description": "Base typing speed in characters per second."
        },
        "agentTypewriter.languageSpeeds": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "default": {},
          "markdownDescription": "Base typing speed per language, in characters per second, keyed by VS Code language ID (for example `{ \"markdown\": 60, \"json\": 120 }`). Language IDs are case-sensitive; find them in the language picker in the status bar. Languages not listed use `#agentTypewriter.charsPerSecond#`."
        },
        "agentTypewriter.jitter": {
          "type": "number",
          "default": 0.6,
          "minimum": 0,
          "maximum": 1,
          "description": "How uneven the typing rhythm is. 0 is perfectly even, 1 is very uneven."
        },
        "agentTypewriter.catchUpFactor": {
          "type": "number",
          "default": 0.5,
          "minimum": 0,
          "description": "Extra speed per queued change, so playback accelerates when the agent gets ahead. Speed = base x (1 + factor x queued), capped at maxSpeedup."
        },
        "agentTypewriter.maxSpeedup": {
          "type": "number",
          "default": 8,
          "minimum": 1,
          "description": "Upper bound on the automatic catch-up multiplier."
        },
        "agentTypewriter.maxAnimatedChars": {
          "type": "number",
          "default": 6000,
          "description": "Changes that add more characters than this are applied instantly instead of typed (big generated files, formatter runs)."
        },
        "agentTypewriter.fileSwitchDelayMs": {
          "type": "number",
          "default": 600,
          "description": "Pause when playback flips to a different file, so the switch reads like a person changing tabs."
        },
        "agentTypewriter.debounceMs": {
          "type": "number",
          "default": 200,
          "description": "Writes to the same file within this window are merged into one change."
        },
        "agentTypewriter.reorderWindowMs": {
          "type": [
            "string",
            "number"
          ],
          "default": "auto",
          "markdownDescription": "How long each change is held so changes reach the timeline in the order files were written, even when the file watcher reports them late. `\"auto\"` uses 2500 ms on Windows and 250 ms elsewhere. `0` adds changes as soon as they are read."
        },
        "agentTypewriter.maxFileSizeKB": {
          "type": "number",
          "default": 512,
          "description": "Files larger than this are ignored."
        },
        "agentTypewriter.gitBaselines": {
          "type": "boolean",
          "default": true,
          "description": "For files git reports as tracked and unmodified, read the first change's before text from git instead of keeping a copy in memory. Needs the git command; turns itself off when git is not available. The watched repository is only read, never changed."
        },
        "agentTypewriter.baselineBudgetMB": {
          "type": "number",
          "default": 256,
          "minimum": 0,
          "description": "Memory budget for in-memory baselines (files not covered by git). Most recently modified files are covered first; a file without a baseline has its first change captured only as a baseline."
        },
        "agentTypewriter.historyLimit": {
          "type": "number",
          "default": 500,
          "minimum": 10,
          "description": "How many changes to keep in the buffer for replay. Oldest are dropped first."
        },
        "agentTypewriter.persistHistory": {
          "type": "boolean",
          "default": true,
          "description": "Keep the recorded changes across window reloads and restarts, in VS Code's storage for this workspace (never in the workspace itself). Up to 64 MB of change text is kept, newest first. Turning this off deletes the saved history."
        },
        "agentTypewriter.ignoreOwnSaves": {
          "type": "boolean",
          "default": true,
          "description": "Do not replay changes you saved from a VS Code editor yourself. Saves are matched by content: if something else writes the file right after your save, that write is still replayed. Turn off if your agent edits VS Code's editor buffers and then saves them."
        },
        "agentTypewriter.viewColumn": {
          "type": "string",
          "enum": [
            "beside",
            "active"
          ],
          "default": "beside",
          "description": "Where the replay editor opens: in a column beside your current editor, or in the active column."
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node18 --external:vscode --outfile=dist/extension.js --sourcemap",
    "watch": "npm run build -- --watch",
    "typecheck": "tsc --noEmit -p .",
    "test": "esbuild test/*.test.ts --bundle --platform=node --format=cjs --target=node18 --outdir=.test-out && node --test .test-out/*.test.js",
    "package": "npm run typecheck && npm test && npm run build -- --minify && vsce package --no-dependencies",
    "vscode:prepublish": "npm run build -- --minify",
    "it": "npm run build && esbuild it/suite.ts it/restore.ts it/runTest.ts --bundle --platform=node --format=cjs --target=node18 --external:vscode --external:@vscode/test-electron --outdir=.it-out && node scripts/run-it.mjs"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "minimatch": "^10.2.6"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
